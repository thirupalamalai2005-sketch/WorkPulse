# Copy to ".env" and fill in. ".env" is git-ignored. Every value below is a PLACEHOLDER.
# Used by docker-compose.yml and (as environment variables) by the application.

# ---- Database
DB_NAME=workpulse_db
DB_USERNAME=workpulse
DB_PASSWORD=change-me-to-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-too

# ---- First administrator (created only when no active ADMIN exists)
# Password policy: 12-128 chars, upper + lower + digit + special character.
WORKPULSE_ADMIN_EMAIL=admin@your-company.example
WORKPULSE_ADMIN_NAME=System Administrator
WORKPULSE_ADMIN_PASSWORD=change-me-Str0ng!Passphrase

# ---- Application
APP_TIMEZONE=Asia/Kolkata
REGISTRATION_ENABLED=false
# Set to true when served over HTTPS (marks the session cookie "Secure")
COOKIE_SECURE=false
