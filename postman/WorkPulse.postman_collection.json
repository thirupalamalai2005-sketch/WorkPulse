{
  "info": {
    "name": "WorkPulse API",
    "description": "Session-cookie API. Run 'Login' first. The collection pre-request script copies the XSRF-TOKEN cookie into the X-XSRF-TOKEN header for state-changing requests (CSRF protection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const method = pm.request.method;",
          "if (['POST','PUT','PATCH','DELETE'].includes(method)) {",
          "  const token = pm.cookies.get('XSRF-TOKEN');",
          "  if (token) { pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token }); }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "admin@example.com"
    },
    {
      "key": "password",
      "value": "<your admin password>"
    },
    {
      "key": "userPassword",
      "value": "Strong@Password123"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "employeeId",
      "value": "1"
    },
    {
      "key": "departmentId",
      "value": "1"
    },
    {
      "key": "correctionId",
      "value": "1"
    },
    {
      "key": "leaveTypeId",
      "value": "1"
    },
    {
      "key": "leaveId",
      "value": "1"
    },
    {
      "key": "holidayId",
      "value": "1"
    },
    {
      "key": "notificationId",
      "value": "1"
    }
  ],
